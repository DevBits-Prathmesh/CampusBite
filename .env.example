# Copy to .env and paste your Neon connection string.
DATABASE_URL=

SESSION_SECRET=replace-with-a-long-random-string

# Android emulator. A physical phone needs your computer LAN IP.
# For a deployed build use the public URL, e.g. https://campusbite.vercel.app
# Re-run `npx cap sync android` after changing this value.
CAPACITOR_SERVER_URL=http://10.0.2.2:3000

# Optional comma-separated origins allowed to call /api/* from another domain.
# Vercel deployment domains and Capacitor's local WebView origins are allowed
# automatically. Add a custom domain here only if the frontend and API are
# hosted on different domains.
ALLOWED_ORIGINS=

# Razorpay (Dashboard → Account & Settings → API Keys).
# Use rzp_test_... keys while developing; replace with live keys to go live.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Account & Settings → Webhooks. The signing secret, not the key secret.
RAZORPAY_WEBHOOK_SECRET=
